<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse">
    <gravity>0 0 -9.81</gravity>
    <physics name="warehouse_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 -0.3 -1</direction>
      <attenuation><range>1000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>
    <model name="floor">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>12 10 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 10 0.1</size></box></geometry>
          <material><ambient>0.72 0.74 0.76 1</ambient><diffuse>0.72 0.74 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_1">
      <static>true</static><pose>0 -2 0.7 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>6 0.8 1.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.8 1.4</size></box></geometry>
          <material><ambient>0.32 0.42 0.48 1</ambient><diffuse>0.32 0.42 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_2">
      <static>true</static><pose>0 0 0.7 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>6 0.8 1.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.8 1.4</size></box></geometry>
          <material><ambient>0.32 0.42 0.48 1</ambient><diffuse>0.32 0.42 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_3">
      <static>true</static><pose>0 2 0.7 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>6 0.8 1.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 0.8 1.4</size></box></geometry>
          <material><ambient>0.32 0.42 0.48 1</ambient><diffuse>0.32 0.42 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static><pose>0 5 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>12 0.15 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.15 1</size></box></geometry>
          <material><ambient>0.6 0.63 0.66 1</ambient><diffuse>0.6 0.63 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -5 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>12 0.15 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.15 1</size></box></geometry>
          <material><ambient>0.6 0.63 0.66 1</ambient><diffuse>0.6 0.63 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>6 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.15 10 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 1</size></box></geometry>
          <material><ambient>0.6 0.63 0.66 1</ambient><diffuse>0.6 0.63 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-6 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.15 10 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 1</size></box></geometry>
          <material><ambient>0.6 0.63 0.66 1</ambient><diffuse>0.6 0.63 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="depot_marker">
      <static>true</static><pose>-4 -3 0.003 0 0 0</pose>
      <link name="marker">
        <!-- Visual only: the depot marking must not obstruct the wheels. -->
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.006</size></box></geometry>
          <material><ambient>0.15 0.65 0.35 1</ambient><diffuse>0.15 0.65 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://warehouse_robot</uri>
      <name>warehouse_robot</name>
      <pose>-4 -3 0 0 0 0</pose>
    </include>
  </world>
</sdf>
