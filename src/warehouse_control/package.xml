<?xml version="1.0"?>
<package format="3">
  <name>warehouse_control</name>
  <version>0.1.0</version>
  <description>Odometry-based goal and aisle-route tracking for the warehouse robot.</description>
  <maintainer email="vargapeter389@gmail.com">Péter Varga</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>warehouse_planning</exec_depend>
  <exec_depend>warehouse_sim</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
