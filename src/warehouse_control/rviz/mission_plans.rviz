Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (odom metres)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 80; 80; 80
    - Class: rviz_default_plugins/MarkerArray
      Name: Mission plans (not travelled paths)
      Enabled: true
      Topic:
        Value: /warehouse/mission_plan_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 65
      X: 4
      Y: 1.5
      Target Frame: odom
Window Geometry:
  Width: 1400
  Height: 900
